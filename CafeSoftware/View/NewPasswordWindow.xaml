<Window x:Class="CafeSoftware.View.NewPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CafeSoftware.View"
        Title="New admin password" Width="380" Height="370" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#101820">
    <StackPanel Margin="20">
        <TextBlock Text="Choose a new admin password" Foreground="White" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="The default password is still in use. Choose your own now, or press Not now and change it later in Settings > General. This window comes back each time you log in until it is changed."
                   Foreground="#F59E0B" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>

        <TextBlock Text="New password (at least 6 characters)" Foreground="#9FB3C8"/>
        <local:RevealPasswordBox x:Name="NewBox" Margin="0,4,0,10"
                                 Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Type it again" Foreground="#9FB3C8"/>
        <local:RevealPasswordBox x:Name="ConfirmBox" Margin="0,4,0,0"
                                 Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{Binding ErrorText}" Foreground="#F87171" TextWrapping="Wrap"
                   MinHeight="20" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Save password" Width="110" Height="30" IsDefault="True"
                    Command="{Binding SaveCommand}"/>
            <Button Content="Not now" Width="80" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>