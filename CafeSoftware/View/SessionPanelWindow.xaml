<Window x:Class="CafeSoftware.View.SessionPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CafeSoftware — Session" Width="340" Height="350"
        MinWidth="340" MinHeight="350"
        Topmost="True" Background="#101820"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Viewbox Stretch="Uniform" Margin="10">
        <StackPanel Width="300" Margin="10">
            <TextBlock Text="TIME REMAINING" Foreground="#9FB3C8" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding TimeText}" Foreground="{Binding TimeBrush}"
                       FontSize="64" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding PaidText}" Foreground="#4ADE80" FontSize="18"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="14"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       MinHeight="38" Margin="0,5,0,15"/>
            <StackPanel Visibility="{Binding ShowDebug, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Test: add coin" Foreground="#4B5D70" FontSize="12" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Button Content="₱1" Width="60" Margin="4"
                            Command="{Binding InsertCoinCommand}" CommandParameter="1"/>
                    <Button Content="₱5" Width="60" Margin="4"
                            Command="{Binding InsertCoinCommand}" CommandParameter="5"/>
                    <Button Content="₱10" Width="60" Margin="4"
                            Command="{Binding InsertCoinCommand}" CommandParameter="10"/>
                </StackPanel>
            </StackPanel>

            <!-- Coin slot connection: grey when ready, red when not connected -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#F87171"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#4ADE80"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionText}" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#F87171"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="#9FB3C8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Viewbox>
</Window>