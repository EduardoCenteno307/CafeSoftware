<UserControl x:Class="CafeSoftware.View.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <PasswordBox x:Name="Hidden" Height="30" FontSize="16" Padding="4,0,34,0"
                     VerticalContentAlignment="Center"
                     PasswordChanged="Hidden_PasswordChanged"/>
        <TextBox x:Name="Shown" Height="30" FontSize="16" Padding="4,0,34,0"
                 VerticalContentAlignment="Center" Visibility="Collapsed"
                 TextChanged="Shown_TextChanged"/>
        <ToggleButton x:Name="Eye" Width="28" Height="24" HorizontalAlignment="Right" Margin="0,0,3,0"
                      FontFamily="Segoe MDL2 Assets" Content="&#xE7B3;" Focusable="False"
                      ToolTip="Show or hide the password"
                      Checked="Eye_Changed" Unchecked="Eye_Changed"/>
    </Grid>
</UserControl>