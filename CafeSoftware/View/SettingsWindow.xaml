<Window x:Class="CafeSoftware.View.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CafeSoftware.View"
        Title="Settings" Width="580" Height="640" MinWidth="540" MinHeight="480"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#101820">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Dark tab headers to match the rest of the app -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9FB3C8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="12,8" Margin="0,0,4,0"
                                Background="#1B2836" CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#243447"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15202B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Admin Settings" Foreground="White" FontSize="22" FontWeight="Bold"/>
            <Border Background="#3B2A0A" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6"
                    Padding="10,6" Margin="0,8,0,0"
                    Visibility="{Binding ShowDefaultPasswordWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="#F59E0B" FontSize="12" TextWrapping="Wrap"
                           Text="The default admin password is still in use, and it is public. Set a new one in the General tab."/>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,12,0,0" SelectedIndex="{Binding SelectedTab}">

            <!-- ============ PRICING ============ -->
            <TabItem Header="Pricing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="#15202B" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Seconds of computer time per ₱1" Foreground="#9FB3C8"/>
                            <TextBox Text="{Binding SecondsPerPeso, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" FontSize="16" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Hint1}" Foreground="#4ADE80" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="A bonus for a coin is set per coin, in the Coin slot tab."
                                       Foreground="#4B5D70" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <TextBlock Text="Alerts (seconds before time ends)" Foreground="#9FB3C8" Margin="0,18,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="First alert" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="70" Height="28" FontSize="14"
                                         Text="{Binding WarnSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Final alert" Foreground="White" VerticalAlignment="Center" Margin="20,0,8,0"/>
                                <TextBox Width="70" Height="28" FontSize="14"
                                         Text="{Binding FinalSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============ COIN SLOT ============ -->
            <TabItem Header="Coin slot">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="#15202B" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Serial port of the coin slot (ESP8266)" Foreground="#9FB3C8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ComboBox Width="120" Height="28" IsEditable="True"
                                          ItemsSource="{Binding Ports}"
                                          Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Refresh" Width="70" Height="28" Margin="8,0,0,0"
                                        Command="{Binding RefreshPortsCommand}"/>
                                <TextBlock Text="Baud" Foreground="White" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <ComboBox Width="90" Height="28" IsEditable="True"
                                          ItemsSource="{Binding BaudRates}"
                                          Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ConnStatusText}" FontSize="13" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F87171"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Foreground" Value="#4ADE80"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="Serial test..." Width="110" Height="28" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Command="{Binding SerialTestCommand}"/>

                            <TextBlock Text="Coin table: what each coin sends and what it gives"
                                       Foreground="#9FB3C8" Margin="0,18,0,4"/>
                            <TextBlock Text="{Binding LastCoinText}" Foreground="#4ADE80" FontSize="13" Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Pulses" Width="55" Foreground="#9FB3C8" FontSize="12"/>
                                <TextBlock Text="Pesos" Width="55" Margin="8,0,0,0" Foreground="#9FB3C8" FontSize="12"/>
                                <TextBlock Text="Bonus (s)" Width="80" Margin="8,0,0,0" Foreground="#9FB3C8" FontSize="12"/>
                                <TextBlock Text="Total time" Margin="8,0,0,0" Foreground="#9FB3C8" FontSize="12"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding PulseRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBox Width="55" Height="26" FontSize="14"
                                                     Text="{Binding Pulses, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Width="55" Height="26" FontSize="14" Margin="8,0,0,0"
                                                     Text="{Binding Pesos, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Width="80" Height="26" FontSize="14" Margin="8,0,0,0"
                                                     Text="{Binding Bonus, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Width="90" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="#4ADE80" Text="{Binding Summary}"/>
                                            <Button Content="✕" Width="28" Height="26" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Add row" Width="90" Height="28" Command="{Binding AddRowCommand}"/>
                                <Button Content="Add last coin" Width="110" Height="28" Margin="8,0,0,0"
                                        Command="{Binding AddLastCoinCommand}"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#4B5D70" FontSize="12" Margin="0,4,0,0"
                                       Text="A coin gives its pesos × the seconds per ₱1 (Pricing tab), plus its own bonus seconds. Bonus 0 = no bonus. Insert a coin to see its pulse count; 'Add last coin' adds a row for it. Coins inserted while this window is open still add time."/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============ SESSION ============ -->
            <TabItem Header="Session">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="#15202B" Padding="16">
                        <StackPanel>
                            <TextBlock Text="When a customer's time ends" Foreground="#9FB3C8"/>
                            <ComboBox Height="28" FontSize="14" Margin="0,4,0,0" SelectedIndex="{Binding EndActionIndex}">
                                <ComboBoxItem Content="Show the lock screen only"/>
                                <ComboBoxItem Content="Restart the PC"/>
                                <ComboBoxItem Content="Shut down the PC"/>
                            </ComboBox>
                            <TextBlock Text="Restart and shut down close everything the customer had open, after a 5 second warning. Does nothing while test mode is on (it only shows a message)."
                                       Foreground="#F59E0B" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <TextBlock Text="Shut down the PC when idle on the lock screen"
                                       Foreground="#9FB3C8" Margin="0,18,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="70" Height="28" FontSize="14"
                                         Text="{Binding IdleMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="minutes with no coin (0 = never shut down)" Foreground="White"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Also does nothing while test mode is on."
                                       Foreground="#4B5D70" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============ GENERAL ============ -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="#15202B" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Shop name (shown on the lock screen)" Foreground="#9FB3C8"/>
                            <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" FontSize="16" Margin="0,4,0,0"/>

                            <CheckBox Content="Test mode (show test coin buttons, allow keyboard shortcuts)"
                                      IsChecked="{Binding DebugMode}" Foreground="White" Margin="0,18,0,0"/>
                            <TextBlock Text="Turn this OFF on the shop PC. Test mode turns off the keyboard lock and the restart and shut down actions."
                                       Foreground="#F59E0B" FontSize="12" TextWrapping="Wrap" Margin="22,2,0,0"/>

                            <TextBlock Text="New admin password (leave empty to keep current)"
                                       Foreground="#9FB3C8" Margin="0,18,0,4"/>
                            <PasswordBox x:Name="NewPwBox" Height="30" FontSize="16"
                                         PasswordChanged="NewPwBox_PasswordChanged"/>

                            <Button Content="Open logs folder" Width="130" Height="28" HorizontalAlignment="Left"
                                    Margin="0,18,0,0" Command="{Binding OpenLogsCommand}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============ WINDOWS SETUP ============ -->
            <TabItem Header="Windows setup">
                <local:WindowsSetupTab/>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding ErrorText}" Foreground="#F87171" TextWrapping="Wrap"
                   MinHeight="20" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Width="80" Height="32" Command="{Binding SaveCommand}"/>
            <Button Content="Exit app" Width="80" Height="32" Margin="8,0,0,0" Command="{Binding ExitAppCommand}"/>
            <Button Content="Close" Width="80" Height="32" Margin="8,0,0,0" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>