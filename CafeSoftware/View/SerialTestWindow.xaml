<Window x:Class="CafeSoftware.View.SerialTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial Test" Width="560" Height="620" MinHeight="460" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#101820">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Serial test (fake ESP8266)" Foreground="White" FontSize="20" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Text="{Binding RemainingText}" Foreground="#4ADE80" FontSize="16" Margin="0,8,0,10"/>

        <TextBlock Grid.Row="2" Foreground="#9FB3C8" Margin="0,0,0,4"
                   Text="Send a message as if the coin slot sent it:"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="COIN ₱1" Width="90" Height="30" Margin="0,0,8,0"
                    Command="{Binding SendCoinCommand}" CommandParameter="1"/>
            <Button Content="COIN ₱5" Width="90" Height="30" Margin="0,0,8,0"
                    Command="{Binding SendCoinCommand}" CommandParameter="5"/>
            <Button Content="COIN ₱10" Width="90" Height="30" Margin="0,0,8,0"
                    Command="{Binding SendCoinCommand}" CommandParameter="10"/>
            <Button Content="Repeat last COIN" Width="130" Height="30" Margin="0,0,8,0"
                    Command="{Binding RepeatLastCommand}"/>
            <Button Content="READY" Width="70" Height="30" Command="{Binding SendReadyCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBox Width="330" Height="28" FontSize="14" VerticalContentAlignment="Center"
                     Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Send text" Width="90" Height="28" Margin="8,0,0,0" IsDefault="True"
                    Command="{Binding SendCustomCommand}"/>
        </StackPanel>

        <ListBox x:Name="LogList" Grid.Row="5" Background="#0B1218" Foreground="White"
                 FontFamily="Consolas" FontSize="13" BorderBrush="#1F2D3D"
                 ItemsSource="{Binding Log}"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Clear log" Width="90" Height="30" Command="{Binding ClearLogCommand}"/>
            <Button Content="Close" Width="90" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
