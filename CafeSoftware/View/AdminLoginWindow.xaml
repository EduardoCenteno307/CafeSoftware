<Window x:Class="CafeSoftware.View.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Login" Width="340" Height="210" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#101820">
    <StackPanel Margin="20">
        <TextBlock Text="Admin login" Foreground="White" FontSize="20" FontWeight="Bold"/>
        <PasswordBox x:Name="PwBox" Height="32" FontSize="16" Margin="0,12,0,0"
                     PasswordChanged="PwBox_PasswordChanged"/>
        <TextBlock Text="{Binding ErrorText}" Foreground="#F87171" Height="22" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Login" Width="80" Height="30" IsDefault="True" Command="{Binding LoginCommand}"/>
            <Button Content="Cancel" Width="80" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
